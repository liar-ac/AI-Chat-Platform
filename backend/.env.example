# =============================================================================
# AIFriends Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git. It contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core (REQUIRED for production)
# -----------------------------------------------------------------------------
# A random secret key for cryptographic signing. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# WARNING: Do NOT use the default dev key in production.
DJANGO_SECRET_KEY=change-me-to-a-random-string

# Set to False in production. True only for local development.
# WARNING: DEBUG=True exposes detailed error pages and disables security features.
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames.
# Example for production: your-domain.com,www.your-domain.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# -----------------------------------------------------------------------------
# MySQL Database (REQUIRED)
# -----------------------------------------------------------------------------
MYSQL_DATABASE=aifriends
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# -----------------------------------------------------------------------------
# AI Model API (REQUIRED for chat features)
# -----------------------------------------------------------------------------
# OpenAI-compatible API key (DeepSeek, OpenAI, etc.)
# WARNING: Never commit real API keys to Git.
API_KEY=your_api_key
API_BASE=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# -----------------------------------------------------------------------------
# Aliyun Voice (OPTIONAL — for ASR / TTS / Voice Cloning)
# -----------------------------------------------------------------------------
ALI_KEY=your_ali_key
WSS_URL=your_wss_url
VOICE_URL=your_voice_url

# -----------------------------------------------------------------------------
# Production Overrides (OPTIONAL)
# -----------------------------------------------------------------------------
# Override MEDIA_URL for production (default: /media/)
# MEDIA_URL=https://your-domain.com/media/
# Comma-separated CORS origins for production
# CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
